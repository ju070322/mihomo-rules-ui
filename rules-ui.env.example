# 复制为 rules-ui.env 后按需修改；rules-ui.env 已被 .gitignore 忽略
# mihomo 主配置路径（服务需要读它来解析代理组、写它来修改内置规则）
MIHOMO_CONFIG_PATH=/etc/mihomo/config.yaml

# 自定义规则数据目录（custom.yaml + providers/*.yaml）
# 必须位于 mihomo 的 HomeDir 内，否则 rule-provider 的 path 会被拒绝
# 默认值：主配置同级的 rules/ 目录
#RULES_DATA_DIR=/etc/mihomo/rules

# 可选的"部署模板"：设置后，修改主配置会同时写一份到模板文件，
# 避免用部署脚本重新生成配置时把改动覆盖掉。不设置则只写线上配置。
#MIHOMO_TEMPLATE_PATH=/path/to/config-template.yaml

# 容器内看到的主配置路径（PUT /configs 需要容器内路径）
MIHOMO_CONTAINER_CONFIG=/root/.config/mihomo/config.yaml

# 监听地址与端口
HOST=0.0.0.0
PORT=3085
